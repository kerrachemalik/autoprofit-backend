# AutoProfit backend — variables d'environnement (ne jamais commiter le vrai .env)

# Base de données PostgreSQL (ex: fournie par Supabase — onglet "Connect")
DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret utilisé pour signer les sessions (jetons JWT). Génère une valeur
# aléatoire longue, ex: `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_string

# Le SEUL compte reconnu comme administrateur
ADMIN_EMAIL=malikbenlebna7@gmail.com

# Port d'écoute du serveur
PORT=3000

# Origine autorisée à appeler cette API (ton app une fois déployée)
CORS_ORIGIN=http://localhost:5173

# --- Identification véhicule (plaque / VIN) — à renseigner une fois le fournisseur choisi ---
VEHICLE_API_PROVIDER=
VEHICLE_API_KEY=

# --- Données de marché (prix, comparables) ---
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# --- Apple In-App Purchase : vérification des reçus d'achat ---
# Clé partagée App Store Connect (pour vérifier les reçus d'abonnement)
APPLE_SHARED_SECRET=

# --- Apify (scraping La Centrale via acteur marketplace) ---
# Token personnel : Apify Console -> Settings -> Integrations
APIFY_TOKEN=
# ID de l'acteur La Centrale utilisé (marketplace Apify)
LACENTRALE_ACTOR_ID=1RE23yinQ3jnRwL9X

# --- Anthropic (analyse IA des problèmes mécaniques / photos de dégâts) ---
# Clé API : console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
